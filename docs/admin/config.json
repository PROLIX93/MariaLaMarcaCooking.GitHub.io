{
  "backend": {
    "name": "github",
    "repo": "PROLIX93/MariaLaMarcaCooking.GitHub.io",
    "branch": "main"
  },
  "site_url": "https://marialamarcacooking.com",
  "display_url": "https://marialamarcacooking.com",
  "publish_mode": "simple",
  "media_folder": "public/uploads",
  "public_folder": "/uploads",
  "collections": [
    {
      "name": "posts",
      "label": "Kitchen posts",
      "label_singular": "Kitchen post",
      "folder": "content/posts",
      "create": true,
      "extension": "json",
      "format": "json",
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "summary": "{{date}} \u2014 {{title}}",
      "sortable_fields": [
        "date",
        "title"
      ],
      "editor": {
        "preview": false
      },
      "fields": [
        {
          "label": "Title",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "Date",
          "name": "date",
          "widget": "datetime",
          "format": "YYYY-MM-DD",
          "date_format": "MMM D, YYYY",
          "time_format": false
        },
        {
          "label": "Category",
          "name": "category",
          "widget": "select",
          "options": [
            "Recipes",
            "Kitchen notes",
            "Something sweet"
          ]
        },
        {
          "label": "Cover photo",
          "name": "image",
          "widget": "image"
        },
        {
          "label": "Short introduction",
          "name": "excerpt",
          "widget": "text"
        },
        {
          "label": "Story",
          "name": "body",
          "widget": "text",
          "hint": "Use a blank line between paragraphs."
        },
        {
          "label": "Hide from website",
          "name": "draft",
          "widget": "boolean",
          "default": true,
          "hint": "Turn off to show this post on the website after saving and deployment. Hidden content remains publicly accessible in the repository and generated JavaScript; do not store private information here."
        }
      ]
    }
  ]
}
